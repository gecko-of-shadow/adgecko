{
  "manifest_version": 3,
  "name": "Adgecko",
  "version": "0.3.1",
  "minimum_chrome_version": "137",
  "description": "Blocks ads on Twitch, YouTube, Kick and other sites, blocks known malware sites, and stops pages from copying shell commands.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://easylist.to/*",
    "https://pgl.yoyo.org/*",
    "https://malware-filter.gitlab.io/*",
    "https://ublockorigin.github.io/*",
    "https://easylist-downloads.adblockplus.org/*",
    "https://secure.fanboy.co.nz/*",
    "https://raw.githubusercontent.com/hagezi/dns-blocklists/*",
    "https://raw.githubusercontent.com/DandelionSprout/adfilt/*",
    "https://filters.adtidy.org/extension/ublock/*"
  ],
  "background": {
    "service_worker": "src/general-background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "general",
        "enabled": true,
        "path": "src/rules/general-network.json"
      },
      {
        "id": "ubo-youtube",
        "enabled": true,
        "path": "src/rules/ubo-youtube-network.json"
      },
      {
        "id": "threat",
        "enabled": true,
        "path": "src/rules/threat-network.json"
      }
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Adgecko",
    "default_icon": {
      "16": "icons/icon16-working.png",
      "48": "icons/icon48-working.png",
      "128": "icons/icon128-working.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/vendor/video-swap-new.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "src/vendor/ubo-youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "src/vendor/ubo-youtube-isolated.js"
      ],
      "css": [
        "src/vendor/ubo-youtube.css",
        "src/youtube-ads.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "src/youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://kick.com/*",
        "*://*.kick.com/*"
      ],
      "js": [
        "src/kick.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/settings/features.js",
        "src/twitch-directory-ads.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://ttvnw.net/*",
        "*://*.ttvnw.net/*",
        "*://jtvnw.net/*",
        "*://*.jtvnw.net/*",
        "*://twitchcdn.net/*",
        "*://*.twitchcdn.net/*",
        "*://twitchcdn.com/*",
        "*://*.twitchcdn.com/*",
        "*://ext-twitch.tv/*",
        "*://*.ext-twitch.tv/*",
        "*://live-video.net/*",
        "*://*.live-video.net/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://*.youtubekids.com/*",
        "*://googlevideo.com/*",
        "*://*.googlevideo.com/*",
        "*://ytimg.com/*",
        "*://*.ytimg.com/*",
        "*://ggpht.com/*",
        "*://*.ggpht.com/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://kickusercontent.com/*",
        "*://*.kickusercontent.com/*",
        "*://kick-streamer.com/*",
        "*://*.kick-streamer.com/*"
      ],
      "js": [
        "src/settings/features.js",
        "src/general/cosmetic-parse.js",
        "src/cosmetic.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*"
      ],
      "js": [
        "src/settings/features.js",
        "src/settings/flags.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://kick.com/*",
        "*://*.kick.com/*"
      ],
      "js": [
        "src/settings/features.js",
        "src/settings/flags.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://ttvnw.net/*",
        "*://*.ttvnw.net/*",
        "*://jtvnw.net/*",
        "*://*.jtvnw.net/*",
        "*://twitchcdn.net/*",
        "*://*.twitchcdn.net/*",
        "*://twitchcdn.com/*",
        "*://*.twitchcdn.com/*",
        "*://ext-twitch.tv/*",
        "*://*.ext-twitch.tv/*",
        "*://live-video.net/*",
        "*://*.live-video.net/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://*.youtubekids.com/*",
        "*://googlevideo.com/*",
        "*://*.googlevideo.com/*",
        "*://ytimg.com/*",
        "*://*.ytimg.com/*",
        "*://ggpht.com/*",
        "*://*.ggpht.com/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://kickusercontent.com/*",
        "*://*.kickusercontent.com/*",
        "*://kick-streamer.com/*",
        "*://*.kick-streamer.com/*"
      ],
      "js": [
        "src/settings/features.js",
        "src/settings/flags.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://ttvnw.net/*",
        "*://*.ttvnw.net/*",
        "*://jtvnw.net/*",
        "*://*.jtvnw.net/*",
        "*://twitchcdn.net/*",
        "*://*.twitchcdn.net/*",
        "*://twitchcdn.com/*",
        "*://*.twitchcdn.com/*",
        "*://ext-twitch.tv/*",
        "*://*.ext-twitch.tv/*",
        "*://live-video.net/*",
        "*://*.live-video.net/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://youtubekids.com/*",
        "*://*.youtubekids.com/*",
        "*://googlevideo.com/*",
        "*://*.googlevideo.com/*",
        "*://ytimg.com/*",
        "*://*.ytimg.com/*",
        "*://ggpht.com/*",
        "*://*.ggpht.com/*",
        "*://kick.com/*",
        "*://*.kick.com/*",
        "*://kickusercontent.com/*",
        "*://*.kickusercontent.com/*",
        "*://kick-streamer.com/*",
        "*://*.kick-streamer.com/*"
      ],
      "js": [
        "src/guards/clipboard.js",
        "src/guards/popups.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  }
}
