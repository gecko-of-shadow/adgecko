{
  "_note": "Shared by the JS runtime (src/general/filter-options.js, general/update.js parseEntries) and the Python packer (scripts/pack-filter-lists.py). expect: [domain, scope key, cancel] or null (filter dropped). Key '' = whole-domain block.",
  "lines": [
    { "line": "||ok.example.com^", "expect": ["ok.example.com", "", false] },
    { "line": "||soundcloud.com^$ping", "expect": ["soundcloud.com", "p=|t=ping|x=", false] },
    { "line": "||onetrust.com^$ping", "expect": ["onetrust.com", "p=|t=ping|x=", false] },
    { "line": "||s1.wp.com^$subdocument,third-party", "expect": ["s1.wp.com", "p=thirdParty|t=sub_frame|x=", false] },
    { "line": "||a2zapk.com^$script,subdocument,third-party,xmlhttprequest", "expect": ["a2zapk.com", "p=thirdParty|t=script,sub_frame,xmlhttprequest|x=", false] },
    { "line": "||brightline.tv^$third-party,~xmlhttprequest", "expect": ["brightline.tv", "p=thirdParty|t=|x=xmlhttprequest", false] },
    { "line": "||objects.tremormedia.com^$~object,third-party", "expect": ["objects.tremormedia.com", "p=thirdParty|t=|x=object", false] },
    { "line": "||go.onelink.me^$image,script", "expect": ["go.onelink.me", "p=|t=image,script|x=", false] },
    { "line": "||party3.example.com^$3p", "expect": ["party3.example.com", "p=thirdParty|t=|x=", false] },
    { "line": "||party1.example.com^$1p", "expect": ["party1.example.com", "p=firstParty|t=|x=", false] },
    { "line": "||notthird.example.com^$~third-party", "expect": ["notthird.example.com", "p=firstParty|t=|x=", false] },
    { "line": "||notfirst.example.com^$~first-party", "expect": ["notfirst.example.com", "p=thirdParty|t=|x=", false] },
    { "line": "||both-parties.example.com^$third-party,first-party", "expect": null },
    { "line": "||pop.example.com^$popup", "expect": null },
    { "line": "||popunder.example.com^$popunder,third-party", "expect": null },
    { "line": "||both.example.com^$script,popup", "expect": ["both.example.com", "p=|t=script|x=", false] },
    { "line": "||imp.example.com^$important", "expect": ["imp.example.com", "", false] },
    { "line": "||impscript.example.com^$important,script", "expect": ["impscript.example.com", "p=|t=script|x=", false] },
    { "line": "||all.example.com^$all", "expect": ["all.example.com", "", false] },
    { "line": "||mc.example.com^$match-case", "expect": ["mc.example.com", "", false] },
    { "line": "||lim.example.com^$domain=news.com", "expect": null },
    { "line": "||from.example.com^$from=news.com", "expect": null },
    { "line": "||to.example.com^$to=news.com", "expect": null },
    { "line": "||redir.example.com^$redirect=noopjs", "expect": null },
    { "line": "||rp.example.com^$removeparam", "expect": null },
    { "line": "||csp.example.com^$csp=script-src 'none'", "expect": null },
    { "line": "||doc.example.com^$document", "expect": ["doc.example.com", "p=|t=main_frame|x=", false] },
    { "line": "||doc2.example.com^$doc", "expect": ["doc2.example.com", "p=|t=main_frame|x=", false] },
    { "line": "||docip.example.com^$doc,ipaddress=192.0.2.1", "expect": null },
    { "line": "||allex.example.com^$all,domain=~example.org", "expect": null },
    { "line": "||strict.example.com^$strict3p", "expect": null },
    { "line": "||den.example.com^$denyallow=a.com", "expect": null },
    { "line": "||meth.example.com^$method=post", "expect": null },
    { "line": "||inline.example.com^$inline-script", "expect": null },
    { "line": "||self-cancel.example.com^$script,~script", "expect": null },
    { "line": "||mixed.example.com^$image,~script", "expect": ["mixed.example.com", "p=|t=image|x=", false] },
    { "line": "||aliases.example.com^$css,xhr,frame,beacon", "expect": ["aliases.example.com", "p=|t=ping,stylesheet,sub_frame,xmlhttprequest|x=", false] },
    { "line": "||UPPER.Example.COM^$SCRIPT,Third-Party", "expect": ["upper.example.com", "p=thirdParty|t=script|x=", false] },
    { "line": "||bad.example.com^$badfilter", "expect": ["bad.example.com", "", true] },
    { "line": "||badscoped.example.com^$script,badfilter", "expect": ["badscoped.example.com", "p=|t=script|x=", true] },
    { "line": "||path.example.com/ads^", "expect": null },
    { "line": "example.com##.ad", "expect": null }
  ],
  "lists": [
    {
      "text": "! Title: sample\n[Adblock Plus 2.0]\n||keep.example.com^\n||gone.example.com^\n||gone.example.com^$badfilter\n||scoped.example.com^$script\n||scoped.example.com^$script,badfilter\n||scoped2.example.com^$image\n0.0.0.0 hosts.example.com\n127.0.0.1 localhost\nbare.example.com\n@@||allow.example.com^\nexample.com##.promo\n||drop.example.com^$redirect=noopjs",
      "expect": {
        "domains": ["keep.example.com", "hosts.example.com", "bare.example.com"],
        "scoped": [["scoped2.example.com", "p=|t=image|x="]]
      }
    }
  ]
}
