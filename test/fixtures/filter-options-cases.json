{
  "_note": "Shared by the JS runtime (src/general/filter-options.js, general/update.js parseEntries) and the Python packer (scripts/pack-filter-lists.py). expect: [domain, scope key, cancel] or null (filter dropped). Key '' = whole-domain block. condition (optional): the DNR condition fields the key must turn into on both sides (keyToCondition / key_to_condition); an excluded-only key always excludes main_frame (it must never block opening the site).",
  "lines": [
    { "line": "||ok.example.com^", "expect": ["ok.example.com", "", false] },
    { "line": "||soundcloud.com^$ping", "expect": ["soundcloud.com", "p=|t=ping|x=", false] },
