    { "line": "||objects.tremormedia.com^$~object,third-party", "expect": ["objects.tremormedia.com", "p=thirdParty|t=|x=object", false], "condition": { "domainType": "thirdParty", "excludedResourceTypes": ["main_frame", "object"] } },
