<?xml version="1.0" encoding="utf-8"?>
<!--
  Adgecko Shield, milestone 1 (docs/android/PLAN.md section 6.3).
  Permissions, exactly these 5. :app:verifyManifestPolicy<Variant> checks
  the merged manifest. No QUERY_ALL_PACKAGES, no Accessibility, no
  notification listener, no IME, no boot receiver, no WebView.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- App exclusion lists the launcher apps only (no QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ShieldApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shield"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on the Quick Settings tile opens this screen. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:theme="@style/Theme.Shield.Translucent" />
        <activity android:name=".ui.RecentBlocksActivity" android:exported="false" />
        <activity android:name=".ui.AllowListActivity" android:exported="false" />
        <activity android:name=".ui.AppExclusionsActivity" android:exported="false" />
        <activity android:name=".ui.AboutActivity" android:exported="false" />

        <!--
          systemExempted: the platform annotation lists SCHEDULE_EXACT_ALARM or
          USE_EXACT_ALARM as "any of" permissions (conditional). For a VPN app the
          condition is the VPN consent (from memory, not checked; plan risk 11).
          The two alarm permissions are not in the M1 policy (owner decision), so
          the lint check ForegroundServicePermission is suppressed here only.
        -->
        <service
            android:name=".vpn.ShieldVpnService"
            tools:ignore="ForegroundServicePermission"
            android:exported="true"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name=".tile.ShieldTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
